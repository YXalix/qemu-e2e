# ==============================================
# QEMU E2E Test Framework Configuration
# ==============================================
# This file is sourced by the Makefile and all shell scripts.
# Copy to .env and customize:  cp .env.example .env

# KERNEL_PATH is auto-detected (one directory above qemu-e2e/).
# Override here only if your layout differs:
# KERNEL_PATH=/path/to/kernel

# Target architecture. Determines QEMU binary, kernel image path, and console device.
#   arm64   -> qemu-system-aarch64  / arch/arm64/boot/Image   / ttyAMA0
#   x86_64  -> qemu-system-x86_64   / arch/x86/boot/bzImage   / ttyS0
#   riscv64 -> qemu-system-riscv64  / arch/riscv/boot/Image   / ttyS0
ARCH=arm64

# --- QEMU ---
# Timeout in seconds for 'make qemu-test'. 0 means no timeout (not recommended).
QEMU_TIMEOUT=30

# --- VM Resources ---
# Per-NUMA-node guest memory. Accepts G or M suffix (e.g. 1G, 2048M, 4G).
# Total guest memory = NUMA_MEMORY * NUMA_NODES.
NUMA_MEMORY=1G

# Number of vCPUs (total, split evenly across NUMA nodes).
# Must be divisible by NUMA_NODES when NUMA_NODES > 1.
SMP=8

# NUMA topology. Number of NUMA nodes exposed to the guest.
#   1   -> single-node (default, no -numa flags), total memory = NUMA_MEMORY
#   >1  -> N nodes, each with NUMA_MEMORY and SMP/N CPUs
# Example: NUMA_MEMORY=1G, SMP=8, NUMA_NODES=2
#   -> total 2G, node0: cpus 0-3 / 1G, node1: cpus 4-7 / 1G
NUMA_NODES=2

# --- Optional Overrides ---
# Uncomment to override auto-detected values:
# QEMU_OPTS=-device vfio-pci,host=XX:XX.X

# --- BusyBox supply (optional) ---
# Prebuilt static busybox comes from GitHub Releases generated by
# .github/workflows/busybox-release.yml (assets: busybox-<ver>-linux-<arch>).
# The same release also ships ready-to-boot rootfs images per arch:
#   rootfs-<ver>-linux-<arch>.cpio.gz   -> qemu -initrd rootfs-....cpio.gz
#   rootfs-<ver>-linux-<arch>.ext4.img  -> qemu -drive ... -append "root=/dev/vda"
# BUSYBOX_VERSION=1.36.1
# Repo publishing the busybox-v* releases (owner/repo); or a full asset URL:
# BUSYBOX_RELEASE_REPO=<owner>/<repo>
# BUSYBOX_DL_URL=https://github.com/<owner>/<repo>/releases/download/busybox-v1.36.1/busybox-1.36.1-linux-arm64
# Set to 1 to force local source build (air-gapped hosts):
# BUSYBOX_SOURCE_BUILD=1
