# ==============================================
# QEMU E2E Test Framework Configuration
# ==============================================
# This file is sourced by the Makefile and all shell scripts.
# Copy to .env and customize:  cp .env.example .env

# KERNEL_PATH is auto-detected (one directory above qemu-e2e/).
# Override here only if your layout differs:
# KERNEL_PATH=/path/to/kernel

# Target architecture. Determines QEMU binary, kernel image path, and console device.
#   arm64   -> qemu-system-aarch64  / arch/arm64/boot/Image   / ttyAMA0
#   x86_64  -> qemu-system-x86_64   / arch/x86/boot/bzImage   / ttyS0
#   riscv64 -> qemu-system-riscv64  / arch/riscv/boot/Image   / ttyS0
ARCH=arm64

# --- QEMU ---
# Timeout in seconds for 'make qemu-test'. 0 means no timeout (not recommended).
QEMU_TIMEOUT=30

# --- Optional Overrides ---
# Uncomment to override auto-detected values:
# QEMU_OPTS=-device vfio-pci,host=XX:XX.X
