{
    // testcases workspace 独立于主 workspace（根 Cargo.toml exclude），显式
    // link 才能被 rust-analyzer 索引；build script 默认开启，会顺带生成
    // compile_commands.json 供 clangd 消费 C 测试体。
    "rust-analyzer.linkedProjects": ["infra/testcases/Cargo.toml"],
    // 覆盖用户级 clangd.arguments（workspace 优先）：不许带
    // --compile-commands-dir——它把 CDB 查找钉死在单一路径、关掉沿源文件
    // 祖先目录的自动搜索，而用例 CDB 在 infra/testcases/<crate>/ 下，
    // 仓库根根本没有，报 'coda.h' file not found。
    "clangd.arguments": [
        "--background-index",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--log=info"
    ]
}
