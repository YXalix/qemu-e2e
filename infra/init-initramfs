#!/bin/sh
# Stage-1 init (initramfs). One job: become able to switch_root into root=.
#
# 1. mount pseudo-filesystems + populate /dev (kernel quirk fallbacks)
# 2. insmod the boot-critical modules (modules-boot.conf: virtio + ext4)
# 3. mount $root and exec switch_root — everything else happens in the rootfs
#
# Modules stay resident across the pivot; test modules are NOT loaded here
# (they live in the rootfs, see modules.conf). Emergency shell if root=
# cannot be mounted.

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
# Some kernels (e.g. openEuler with CONFIG_DEVTMPFS_MOUNT) leave the
# initramfs /dev empty even with devtmpfs mounted — repopulate from sysfs.
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1 2>/dev/null
[ -e /dev/null ] || mknod -m 666 /dev/null c 1 3 2>/dev/null
mdev -s 2>/dev/null || true

# Insmod the boot set. Best-effort: a missing non-critical module only warns;
# a missing critical one shows up as "root device never appears" below.
if [ -f /lib/modules/modules-boot.conf ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        [ "${line#\#}" != "$line" ] && continue
        # shellcheck disable=SC2086
        set -- $line
        mod="$1"
        shift
        if [ -f "/lib/modules/${mod}.ko" ]; then
            insmod "/lib/modules/${mod}.ko" "$@" 2>/dev/null \
                || echo "[initramfs] WARN: insmod ${mod}.ko failed"
        fi
    done < /lib/modules/modules-boot.conf
fi

# Resolve root= from the kernel cmdline (default: first virtio disk)
ROOT=""
for p in $(cat /proc/cmdline); do
    case "$p" in
        root=*) ROOT="${p#root=}" ;;
    esac
done
ROOT="${ROOT:-/dev/vda}"

# Device may lag behind insmod (async probe) — poll briefly
n=0
while [ ! -b "$ROOT" ] && [ "$n" -lt 20 ]; do
    n=$((n + 1))
    sleep 0.5
done

# Some kernels expose the disk in /proc/partitions with an EMPTY sysfs
# dev attribute (observed on openEuler + modified QEMU), so mdev -s cannot
# create the node — parse /proc/partitions and mknod it ourselves.
if [ ! -b "$ROOT" ]; then
    name="${ROOT##*/}"
    # shellcheck disable=SC2046
    set -- $(grep -w "$name" /proc/partitions 2>/dev/null | head -1)
    if [ "$#" -eq 4 ]; then
        echo "[initramfs] sysfs dev attr empty; mknod $ROOT b $1 $2"
        mknod -m 660 "$ROOT" b "$1" "$2" 2>/dev/null || true
    fi
fi

if mount -o rw "$ROOT" /mnt 2>/tmp/.mount.err; then
    # busybox switch_root moves /proc /sys /dev mounts into the new root
    exec switch_root /mnt /init
fi

echo "[initramfs] ERROR: cannot mount root=$ROOT: $(cat /tmp/.mount.err 2>/dev/null)"
echo "[initramfs] dropping to emergency shell"
exec setsid cttyhack /bin/sh
