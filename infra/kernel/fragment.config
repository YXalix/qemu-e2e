# virtuoso preset 内核 fragment —— 在各架构 defconfig 之上合并
# （scripts/kconfig/merge_config.sh + olddefconfig），三架构共用一份：
# 架构特有项在其他架构上由 olddefconfig 自然丢弃。
#
# 目标：QEMU virt 机器可引导的最小供给面，全部 =y 内建、零模块——
# 装置 E2E 与开箱即用不依赖内核树模块供给（modules.conf 的 .ko 查找
# 对 preset 内核整体跳过）。被测内核行为的权威仍是 openEuler 源码树。

# 虚拟机设备面（virt 机器）
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y

# 块层与根文件系统（rootfs.img = ext4；initramfs 当根也可引导）
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 串口 console（标记协议 v1 的出口；arm64 = PL011，x86_64/riscv64 = 8250）
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# 用户态执行面（静态 ELF 测试用例 + shell 脚本 init）
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PRINTK=y
