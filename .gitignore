# testcase 的 compile_commands.json（各用例 crate 的 build.rs 生成，clangd 用）
infra/testcases/**/compile_commands.json
# clangd background-index 本机缓存（跟随 CDB 落在用例 crate 根）
.cache/

# Build artifacts
**.cmd
**.mod
**.o
**.ko
**.order
# Rust build artifacts
/target

# Local editor settings（白名单 .vscode/settings.json：rust-analyzer 需要
# linkedProjects 才能索引被主 workspace exclude 的 testcases workspace）
.vscode/*
!.vscode/settings.json

# testcase workspace build dir
infra/testcases/target/

# guest tools workspace build dir
infra/tools/target/

# ZCode session-local data
.zcode/

# 本机会话状态（virtuoso kernel current 活动卷指针等）
.virtuoso/
